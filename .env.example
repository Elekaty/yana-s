# Set to true only on a private machine. Ignored on Vercel production.
NEXT_PUBLIC_DEMO_MODE=

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Filled in later steps. Leave blank until you have them.
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=

# Random secrets. Generate new ones for production. CRON_SECRET also signs the parent PIN cookie.
TELEGRAM_WEBHOOK_SECRET=
# Shared with the class-group listener in workers/telegram-userbot. Not the bot token.
USERBOT_WEBHOOK_SECRET=
INBOUND_EMAIL_SECRET=
CRON_SECRET=

# Public address of this app, used to register the Telegram webhook.
# Use the team address. https://yana-s.vercel.app is not this project.
APP_URL=https://yana-s-ele18.vercel.app
# Domain that receives forwarded school mail, for example school.yourdomain.com
INBOUND_EMAIL_DOMAIN=

# Cloudflare Email Routing worker (scripts/email-worker.js). Same secret as INBOUND_EMAIL_SECRET above.
INTAKE_URL=https://yana-s-ele18.vercel.app/api/intake/email

# Web push. Generate a pair; the private key stays on the server.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Class-group listener (workers/telegram-userbot). Leave empty until that host is set up.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TARGET_CHAT_ID=
VERCEL_RECEIVER_URL=https://yana-s-ele18.vercel.app/api/intake/userbot
FAMILY_INVITE_CODE=
